<%- include('partials/head') %><section class="auth-layout"><div class="auth-art"><span class="eyebrow">YOUR EVERYDAY, ELEVATED.</span><h1>Make yourself<br>at home.</h1><img src="/images/home.svg" alt="A sculptural table lamp"><p>A world of thoughtful finds awaits.</p></div><div class="auth-form"><a class="text-link" href="/">← Back to the good stuff</a><span class="eyebrow">WELCOME TO NEXORA</span><h1><%= mode==='login'?'Good to see you.':mode==='register'?'Your next chapter.':mode==='forgot-password'?'A fresh start.':mode==='verify-email'?'One little step.':'Set a new password.' %></h1><p><%= mode==='login'?'Sign in and pick up where you left off.':mode==='register'?'Create your account. Find your everyday.':'This is a local email simulation; no external email is sent.' %></p><form action="/auth/<%= mode %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(mode==='register'){ %><label>Your name<input name="name" autocomplete="name" minlength="2" maxlength="80" required></label><% } %><% if(['login','register','forgot-password'].includes(mode)){ %><label>Email address<input type="email" name="email" autocomplete="email" required></label><% } %><% if(['login','register','reset-password'].includes(mode)){ %><label>Password<input type="password" name="password" autocomplete="<%= mode==='login'?'current-password':'new-password' %>" minlength="<%= mode==='login'?1:10 %>" maxlength="72" required></label><% if(mode!=='login'){ %><small>At least 10 characters, with uppercase, lowercase and a number.</small><% } %><% } %><% if(['reset-password','verify-email'].includes(mode)){ %><input type="hidden" name="token" value="<%= token %>"><% } %><% if(mode==='register'){ %><label>I’m here to<select name="role"><option value="customer">Discover and shop</option><option value="seller">Sell my products (approval required)</option></select></label><% } %><button class="button wide"><%= mode==='login'?'Sign in':mode==='register'?'Create account':mode==='verify-email'?'Verify my email':'Continue' %> <i data-lucide="arrow-right"></i></button></form><% if(mode==='login'){ %><a href="/auth/forgot-password">Forgot your password?</a><p>New around here? <a href="/auth/register"><strong>Join NEXORA</strong></a></p><% }else{ %><a href="/auth/login">Already have an account? Sign in</a><% } %><p class="small muted">College project · Simulated purchases only</p></div></section><%- include('partials/footer') %>
