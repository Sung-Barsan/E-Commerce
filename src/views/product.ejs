<%- include('partials/head') %><div class="section"><nav class="breadcrumbs"><a href="/products">The collection</a> / <a href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a> / <span><%= product.name %></span></nav><section class="product-detail"><div class="detail-image"><img src="<%= product.images[0] %>" alt="<%= product.name %>"></div><div class="detail-copy"><span class="eyebrow"><%= product.brand %> · THE NEXORA COLLECTION</span><h1><%= product.name %></h1><p class="rating">★ <%= product.rating.toFixed(1) %> · <%= product.reviewCount %> verified reviews</p><p class="detail-price"><%= money(product.price) %> <% if(product.compareAt > product.price){ %><del><%= money(product.compareAt) %></del><% } %></p><p><%= product.description %></p><p class="stock" data-stock="<%= product._id %>"><%= product.stock %> available</p><% if(product.stock){ %><form action="/cart/items" method="post" data-async><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="product" value="<%= product._id %>"><label>Quantity<input type="number" name="quantity" min="1" max="<%= Math.min(20,product.stock) %>" value="1" required></label><button class="button wide"><i data-lucide="shopping-bag"></i> Add to bag</button></form><% } %><form action="/wishlist/<%= product._id %>" method="post" data-async><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary wide"><i data-lucide="heart"></i> Save for later</button></form><div class="detail-notes"><span><i data-lucide="truck"></i> Free demo shipping over ₹4,999</span><span><i data-lucide="shield-check"></i> All purchases are simulated</span></div><p class="muted">Sold by <%= product.seller.storeName || product.seller.name %><br>SKU <%= product.sku %></p></div></section><section class="reviews"><h2>Real purchases. Demo experiences.</h2><p>Reviews are permitted only after a delivered demo order.</p><% reviews.forEach(r => { %><article class="panel"><strong><%= r.user?.name || 'Customer' %> · <%= r.rating %>/5</strong><span class="badge">Verified demo purchase</span><p><%= r.text %></p></article><% }) %><% if(!reviews.length){ %><p class="muted">Be the first to share your experience after your demo delivery.</p><% } %><% if(user?.role==='customer'){ %><form class="panel" action="/reviews/<%= product._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Your rating<select name="rating"><% [5,4,3,2,1].forEach(n=>{ %><option><%= n %></option><% }) %></select></label><label>Your review<textarea name="text" minlength="3" maxlength="1000" required></textarea></label><button class="button">Submit review</button></form><% } %></section><div class="section-heading"><h2>Good together.</h2><a href="/products">Explore more ↗</a></div><div class="product-grid"><% related.forEach(product => { %><%- include('partials/card',{product}) %><% }) %></div></div><%- include('partials/footer') %>
