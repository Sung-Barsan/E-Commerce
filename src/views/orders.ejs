<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><span class="eyebrow">FOLLOW EVERY LITTLE STEP</span><h1><%= title %>.</h1><% if(!orders.length){ %><div class="empty-state"><h2>No orders yet.</h2><a class="button" href="/products">Explore the collection</a></div><% } %><% orders.forEach(o=>{ %><article class="panel"><div class="section-heading"><div><h2><%= o.number %></h2><small><%= o.createdAt.toLocaleDateString('en-IN') %></small></div><span class="badge"><%= o.status %></span><strong><%= money(o.total) %></strong></div><% o.items.forEach(i=>{ %><div class="order-row"><span><%= i.name %> × <%= i.quantity %></span><strong><%= money(i.price*i.quantity) %></strong><span><%= i.status %></span><% if(management){ const next = {Confirmed:'Processing',Processing:'Shipped',Shipped:'Out for Delivery','Out for Delivery':'Delivered'}[i.status]; if(next){ %><form action="/<%= user.role==='seller'?'seller':'admin' %>/orders/<%= o._id %>/items/<%= i._id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= next %>"><button class="small-button">Mark <%= next %></button></form><% } } %></div><% }) %><% if(!management){ %><a class="text-link" href="/orders/<%= o._id %>">View your order →</a><% }else{ %><p class="small muted">Delivery: <%= o.address.name %>, <%= o.address.line %>, <%= o.address.city %>, <%= o.address.state %> <%= o.address.postal %></p><% } %></article><% }) %></section></div><%- include('partials/footer') %>
