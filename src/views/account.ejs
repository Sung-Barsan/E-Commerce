<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><span class="eyebrow">A LITTLE SPACE OF YOUR OWN</span><h1>Hello, <%= user.name.split(' ')[0] %>.</h1><p>Your finds, favorites, and everything in between.</p><div class="metric-grid"><a class="metric" href="/orders"><span>Shopping history</span><strong>My orders ↗</strong></a><a class="metric" href="/wishlist"><span>Your favorites</span><strong>Saved finds ↗</strong></a><a class="metric" href="/account/addresses"><span>Delivery details</span><strong><%= user.addresses.length %> addresses</strong></a></div><div class="section-heading"><h2>Recent good things.</h2><a href="/orders">All orders ↗</a></div><% if(!orders.length){ %><div class="empty-state"><h2>Your story starts here.</h2><a class="button" href="/products">Explore the collection</a></div><% } %><% orders.forEach(o=>{ %><a class="order-row" href="/orders/<%= o._id %>"><strong><%= o.number %></strong><span><%= o.createdAt.toLocaleDateString('en-IN') %></span><span class="badge"><%= o.status %></span><strong><%= money(o.total) %> →</strong></a><% }) %></section></div><%- include('partials/footer') %>
