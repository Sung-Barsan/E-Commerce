<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="<%= csrf %>"><meta name="description" content="NEXORA Commerce. Thoughtfully selected everyday essentials. A student-built, entirely simulated shopping experience."><link rel="canonical" href="<%= baseUrl + path %>"><title><%= title %> · NEXORA</title><link rel="icon" href="/images/logo.svg" type="image/svg+xml"><link rel="stylesheet" href="/build/style.css"><script type="module" src="/build/app.js"></script></head><body data-authenticated="<%= !!user %>">
<div class="announcement">A little upgrade. A better everyday. <span>Free demo delivery on orders ₹4,999+</span><a href="/about">Meet NEXORA <span aria-hidden="true">↗</span></a></div>
<header class="header"><a href="/" class="logo" aria-label="Nexora home"><span class="logo-symbol">n</span>NEXORA<span class="logo-dot">®</span></a><nav class="desktop-nav" aria-label="Main"><a class="<%= path === '/products' ? 'active' : '' %>" href="/products">Shop all</a><a href="/categories">Categories</a><a href="/products?sort=newest">New arrivals <span class="tiny-dot"></span></a><a href="/about">Our story</a></nav><div class="header-actions"><button class="icon-btn" id="search-toggle" aria-label="Search products" aria-expanded="false"><i data-lucide="search"></i></button><button class="icon-btn" id="theme-toggle" aria-label="Toggle color theme"><i data-lucide="sun-moon"></i></button><a class="icon-btn account-link" href="<%= user ? '/account' : '/auth/login' %>" aria-label="Account"><i data-lucide="user-round"></i></a><a class="icon-btn" href="/wishlist" aria-label="Wishlist"><i data-lucide="heart"></i></a><% if(user){ %><a class="icon-btn notification-link" href="/notifications" aria-label="Notifications"><i data-lucide="bell"></i><span class="notification-count" data-unread><%= unread %></span></a><% } %><a class="bag-link" href="/cart" aria-label="Shopping bag"><i data-lucide="shopping-bag"></i><span id="cart-count"><%= cartCount %></span></a><button class="icon-btn mobile-only" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i data-lucide="menu"></i></button></div></header>
<div class="search-panel" id="search-panel" hidden><form action="/products"><label class="sr-only" for="global-search">Search products</label><input id="global-search" name="q" placeholder="Find your next everyday essential…" autocomplete="off"><button class="button" type="submit">Search</button></form><div id="search-results"></div></div>
<nav class="mobile-nav" id="mobile-menu" hidden aria-label="Mobile navigation"><a href="/products">Shop all</a><a href="/categories">Categories</a><a href="/products?sort=newest">New arrivals</a><a href="/account">Your account</a><a href="/about">Our story</a></nav>
