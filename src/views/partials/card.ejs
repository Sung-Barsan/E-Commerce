<article class="product-card" data-product="<%= product._id %>"><div class="product-image-wrap"><a href="/products/<%= product.slug %>" aria-label="View <%= product.name %>"><img loading="lazy" src="<%= product.images[0] || '/images/product.svg' %>" alt="<%= product.name %>" width="600" height="600"></a><span class="product-tag"><%= product.stock === 0 ? 'SOLD OUT' : product.featured ? 'THE EDIT' : 'NEW FIND' %></span><% if (user?.role === 'customer') { %><form action="/wishlist/<%= product._id %>" method="post" data-async><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="save-product" aria-label="Save <%= product.name %>"><i data-lucide="heart"></i></button></form><% } else { %><a href="/auth/login" class="save-product" aria-label="Sign in to save"><i data-lucide="heart"></i></a><% } %></div><div class="product-meta"><span><%= product.category %></span><span>★ <%= product.reviewCount ? product.rating.toFixed(1) : 'New' %></span></div><h3><a href="/products/<%= product.slug %>"><%= product.name %></a></h3><div class="product-bottom"><span class="price"><%= money(product.price) %> <% if (product.compareAt > product.price) { %><del><%= money(product.compareAt) %></del><% } %></span><a class="round-link" href="/products/<%= product.slug %>" aria-label="View <%= product.name %>">↗</a></div></article>
