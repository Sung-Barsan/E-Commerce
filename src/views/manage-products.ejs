<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><div class="section-heading"><h1><%= title %>.</h1><% if(!moderation&&user.approved){ %><a class="button" href="/seller/products/new">New product +</a><% } %></div><div class="table-wrap panel"><table><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><strong><%= p.name %></strong><small><%= p.sku %></small></td><td><%= money(p.price) %></td><td><%= p.stock %></td><td><span class="badge"><%= p.status %></span></td><td><% if(moderation){ %><form action="/admin/products/<%= p._id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><option value="active">Approve</option><option value="rejected">Reject</option><option value="archived">Archive</option></select><button class="small-button">Apply</button></form><% }else{ %><a href="/seller/products/<%= p._id %>/edit">Edit ↗</a><form action="/seller/products/<%= p._id %>/archive" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button">Archive</button></form><% } %></td></tr><% }) %></tbody></table><% if(!products.length){ %><p class="empty-state">Your first product starts here.</p><% } %></div></section></div><%- include('partials/footer') %>
