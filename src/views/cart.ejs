<%- include('partials/head') %><section class="section"><div class="page-intro"><span class="eyebrow">GOOD CHOICES, ALL TOGETHER</span><h1>Your shopping bag.</h1></div><% if(warning){ %><p class="notice"><%= warning %></p><% } %><% if(!cart?.items.length){ %><div class="empty-state"><i data-lucide="shopping-bag"></i><h2>A little room for something good.</h2><p>Your bag is empty. Let’s find your next favorite.</p><a class="button" href="/products">Explore the collection ↗</a></div><% }else{ %><div class="checkout-layout"><div><% cart.items.forEach(item=>{ %><article class="cart-line"><img src="<%= item.product?.images[0] || '/images/product.svg' %>" alt="<%= item.product?.name || 'Unavailable product' %>"><div><h3><%= item.product?.name || 'Unavailable product' %></h3><p><%= item.product ? money(item.product.price):'Unavailable' %></p><form action="/cart/items" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="product" value="<%= item.product?._id || item._id %>"><label class="sr-only" for="qty-<%= item._id %>">Quantity</label><input id="qty-<%= item._id %>" type="number" min="0" max="20" name="quantity" value="<%= item.quantity %>"><button class="small-button">Update</button><small>Set to 0 to remove</small></form></div><strong><%= item.product?money(item.product.price*item.quantity):'' %></strong></article><% }) %><form action="/cart/clear" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button">Clear bag</button></form></div><aside class="summary panel"><h2>The good details.</h2><% if(summary){ %><dl><div><dt>Subtotal</dt><dd><%= money(summary.subtotal) %></dd></div><div><dt>Discount</dt><dd>− <%= money(summary.discount) %></dd></div><div><dt>Demo shipping</dt><dd><%= summary.shipping?money(summary.shipping):'On us' %></dd></div><div class="total"><dt>Total</dt><dd><%= money(summary.total) %></dd></div></dl><% } %><form action="/cart/coupon" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Have a demo code?<input name="code" value="<%= cart.coupon %>" maxlength="30" placeholder="Try NEXORA10"></label><button class="button secondary wide">Apply code</button><small>Leave blank and apply to remove.</small></form><% if(summary){ %><a class="button wide" href="/checkout">Continue to checkout →</a><% } %><p class="small muted">DEMO PAYMENT — NO REAL MONEY WILL BE CHARGED.</p></aside></div><% } %></section><%- include('partials/footer') %>
