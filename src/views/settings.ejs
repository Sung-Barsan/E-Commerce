<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><h1>Make it personal.</h1><div class="settings-grid"><form class="panel" action="/account/profile" method="post"><h2>Your profile</h2><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input name="name" value="<%= user.name %>" minlength="2" maxlength="80" required></label><% if(user.role==='seller'){ %><label>Store name<input name="storeName" value="<%= user.storeName || '' %>" maxlength="100"></label><p>Seller approval: <%= user.approved?'Approved':'Pending review' %></p><% } %><p><%= user.email %> · <%= user.verified?'Verified':'Not verified' %></p><button class="button">Save profile</button></form><form class="panel" action="/account/password" method="post"><h2>Password & security</h2><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Current password<input name="current" type="password" autocomplete="current-password" required></label><label>New password<input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="72" required></label><small>10+ characters, uppercase, lowercase and number.</small><button class="button">Change password</button></form></div><% if(!user.verified){ %><form action="/auth/resend-verification" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button">Generate local verification email</button></form><% } %><h2>Saved addresses</h2><div class="settings-grid"><% user.addresses.forEach(a=>{ %><div class="panel"><strong><%= a.name %></strong><p><%= a.line %><br><%= a.city %>, <%= a.state %> <%= a.postal %></p><form action="/account/addresses/<%= a._id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button">Remove address</button></form></div><% }) %></div><form class="panel" action="/account/addresses" method="post"><h2>Add a demo address</h2><p class="muted">Use fictional details for your college demonstration.</p><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><% [['name','Full name'],['line','Street address'],['city','City'],['state','State'],['postal','6-digit PIN code'],['phone','10-digit demo phone']].forEach(([name,label])=>{ %><label><%= label %><input name="<%= name %>" required <%- name==='postal'?'pattern="[0-9]{6}"':name==='phone'?'pattern="[0-9]{10}"':'' %>></label><% }) %></div><button class="button">Save address</button></form></section></div><%- include('partials/footer') %>
