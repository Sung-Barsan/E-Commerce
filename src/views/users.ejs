<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><h1><%= title %>.</h1><p>Super-admin accounts are protected from web role changes.</p><div class="table-wrap panel"><table><thead><tr><th>Person</th><th>Role</th><th>Account status</th><th>Actions</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.name %></strong><small><%= u.email %></small></td><td><%= u.role %></td><td><%= u.suspended?'Suspended':u.role==='seller'&&!u.approved?'Pending approval':'Active' %></td><td><% if(!['admin','superadmin'].includes(u.role)){ %><form action="/admin/users/<%= u._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="action"><% if(u.role==='seller'&&!u.approved){ %><option value="approve">Approve seller</option><% } %><option value="suspend">Suspend</option><option value="restore">Restore</option></select><button class="small-button">Apply</button></form><% } %><% if(user.role==='superadmin'&&u.role!=='superadmin'){ %><form action="/super-admin/users/<%= u._id %>/role" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="role"><% ['customer','seller','admin'].forEach(r=>{ %><option <%= r===u.role?'selected':'' %>><%= r %></option><% }) %></select><button class="small-button">Assign role</button></form><% } %></td></tr><% }) %></tbody></table></div></section></div><%- include('partials/footer') %>
