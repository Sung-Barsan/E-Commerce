<%- include('partials/head') %><section class="section"><div class="page-intro"><span class="eyebrow">A GOOD CHOICE, CONFIRMED</span><h1><%= order.number %></h1><p><%= order.createdAt.toLocaleString('en-IN') %> · <%= order.status %></p><p class="notice">DEMO PAYMENT — NO REAL MONEY WILL BE CHARGED.</p></div><div class="checkout-layout"><div class="panel"><h2>Your finds</h2><% order.items.forEach(i=>{ %><div class="cart-line"><img src="<%= i.image %>" alt="<%= i.name %>"><div><h3><%= i.name %></h3><p>Quantity <%= i.quantity %> · <%= i.status %></p></div><strong><%= money(i.price*i.quantity) %></strong></div><% }) %><h2>The journey</h2><ol class="timeline"><% order.timeline.forEach(t=>{ %><li><strong><%= t.text %></strong><small><%= t.at.toLocaleString('en-IN') %></small></li><% }) %></ol></div><aside><div class="panel"><h2>Order details</h2><p><%= order.address.name %><br><%= order.address.line %><br><%= order.address.city %>, <%= order.address.state %> <%= order.address.postal %></p><dl><div><dt>Method</dt><dd>Demo <%= order.method.toUpperCase() %></dd></div><div><dt>Payment record</dt><dd><%= order.payment %></dd></div><div class="total"><dt>Total</dt><dd><%= money(order.total) %></dd></div></dl><% if(['Confirmed','Processing'].includes(order.status)&&order.items.every(i=>['Confirmed','Processing'].includes(i.status))){ %><form action="/orders/<%= order._id %>/cancel" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary wide">Cancel demo order</button></form><% } %><% if(order.status==='Delivered'&&!returnRequest){ %><form action="/orders/<%= order._id %>/return" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Return reason<textarea name="reason" minlength="5" maxlength="500" required></textarea></label><button class="button secondary wide">Request demo return</button></form><% } %><% if(returnRequest){ %><p class="notice">Return: <%= returnRequest.status %></p><% } %></div><a class="text-link" href="/orders">← Back to your orders</a></aside></div></section><%- include('partials/footer') %>
