<%- include('partials/head') %><section class="page-intro"><span class="eyebrow">GOOD FINDS START HERE</span><h1><%= title %><span class="accent">.</span></h1><p>Considered essentials. Unexpected favorites. All in one place.</p></section><div class="catalog-layout"><aside class="filters"><form action="/products"><h2>Refine your finds</h2><label>Search<input name="q" value="<%= q.q %>" placeholder="What are you looking for?"></label><label>Category<select name="category"><option value="">All categories</option><% categories.forEach(c => { %><option <%= q.category === c.name ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label><label>Brand<select name="brand"><option value="">All brands</option><% brands.forEach(b => { %><option <%= q.brand === b ? 'selected' : '' %>><%= b %></option><% }) %></select></label><div class="form-grid"><label>Min ₹<input name="min" type="number" min="0" value="<%= q.min %>"></label><label>Max ₹<input name="max" type="number" min="0" value="<%= q.max %>"></label></div><label>Rating<select name="rating"><% [0,1,2,3,4,5].forEach(r => { %><option value="<%= r %>" <%= q.rating === r ? 'selected' : '' %>><%= r === 0 ? 'All ratings' : r + '+ stars' %></option><% }) %></select></label><label>Sort by<select name="sort"><% Object.entries({newest:'Newest first',oldest:'Oldest first',low:'Price: low to high',high:'Price: high to low',rating:'Highest rated',popular:'Most popular'}).forEach(([key,value]) => { %><option value="<%= key %>" <%= q.sort === key ? 'selected' : '' %>><%= value %></option><% }) %></select></label><label class="check"><input type="checkbox" name="stock" <%= q.stock === 'on' ? 'checked' : '' %>> In stock only</label><button class="button">Apply filters</button><a class="text-link" href="/products">Reset filters</a></form></aside><section><div class="catalog-top"><span><%= count %> thoughtful finds</span><span>THE EVERYDAY COLLECTION</span></div><div class="product-grid catalog-products"><% products.forEach(product => { %><%- include('partials/card', { product }) %><% }) %></div><% if (!products.length) { %><div class="empty-state"><i data-lucide="search"></i><h2>No matches just yet.</h2><p>Try another search or clear your filters.</p><a class="button" href="/products">Explore all products</a></div><% } %><nav class="pagination" aria-label="Product pages"><% for(let p = Math.max(1,q.page-2);p<=Math.min(pages,q.page+2);p++){ const params = new URLSearchParams({...q,page:p}); %><a href="/products?<%= params.toString() %>" class="<%= p===q.page?'selected':'' %>" <%- p===q.page?'aria-current="page"':'' %>><%= p %></a><% } %></nav></section></div><%- include('partials/footer') %>
