<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><h1>Demo promotions.</h1><form class="panel" action="/admin/coupons" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><label>Code<input name="code" pattern="[A-Z0-9]{3,30}" required></label><label>Discount %<input type="number" name="percent" min="1" max="100" required></label><label>Maximum discount ₹<input type="number" name="maximum" min="1" required></label><label>Minimum order ₹<input type="number" name="minimum" min="0" required></label><label>Total uses allowed<input type="number" name="maxUses" min="1" required></label><label>Expiry<input type="date" name="expires" required></label></div><p>One use per customer, including cancelled orders.</p><button class="button">Create demo coupon</button></form><% coupons.forEach(c=>{ %><div class="order-row"><strong><%= c.code %></strong><span><%= c.percent %>% · <%= c.uses %>/<%= c.maxUses %> used · <%= c.active?'Active':'Disabled' %></span><form action="/admin/coupons/<%= c._id %>/disable" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small-button">Disable</button></form></div><% }) %></section></div><%- include('partials/footer') %>
