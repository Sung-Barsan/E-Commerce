<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><h1><%= title %>.</h1><p>New and edited listings go through administrator moderation.</p><form class="panel" action="/seller/products<%= product?'/'+product._id:'' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><label>Name<input name="name" value="<%= product?.name||'' %>" required minlength="3" maxlength="120"></label><label>SKU<input name="sku" value="<%= product?.sku||'' %>" required minlength="3" maxlength="60"></label><label>Brand<input name="brand" value="<%= product?.brand||'' %>" maxlength="80"></label><label>Category<select name="category"><% categories.forEach(c=>{ %><option <%= product?.category===c.name?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Price in ₹<input type="number" name="price" min="1" max="1000000" step=".01" value="<%= product?product.price/100:'' %>" required></label><label>Stock<input type="number" name="stock" min="0" max="100000" value="<%= product?.stock||0 %>" required></label></div><label>Description<textarea name="description" minlength="10" maxlength="5000" required><%= product?.description||'' %></textarea></label><button class="button">Save for review</button></form><% if(product){ %><form class="panel" id="image-upload" action="/api/v1/seller/products/<%= product._id %>/image" method="post" enctype="multipart/form-data"><h2>Product image</h2><p>JPEG, PNG or WebP. Maximum 5 MB. Uploading triggers moderation.</p><input name="image" type="file" accept="image/jpeg,image/png,image/webp" required><button class="button secondary">Upload image</button><p class="small muted">This upload requires JavaScript for the CSRF-protected request.</p></form><% } %></section></div><%- include('partials/footer') %>
