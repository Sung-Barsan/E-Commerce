<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><h1>Categories.</h1><form class="panel" action="/admin/categories" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>New category<input name="name" minlength="2" maxlength="80" required></label><button class="button">Create category</button></form><% categories.forEach(c=>{ %><div class="order-row"><strong><%= c.name %></strong><form action="/admin/categories/<%= c._id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small-button">Delete empty category</button></form></div><% }) %></section></div><%- include('partials/footer') %>
