<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><div class="section-heading"><h1>Your updates.</h1><form action="/notifications/read" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary">Mark all as read</button></form></div><% if(!notifications.length){ %><div class="empty-state"><i data-lucide="bell"></i><h2>All quiet for now.</h2><p>Your order and account updates will appear here.</p></div><% } %><% notifications.forEach(n=>{ %><a class="panel notification <%= n.read?'read':'' %>" href="<%= n.href %>"><strong><%= n.title %></strong><p><%= n.message %></p><small><%= n.createdAt.toLocaleString('en-IN') %></small></a><% }) %></section></div><%- include('partials/footer') %>
