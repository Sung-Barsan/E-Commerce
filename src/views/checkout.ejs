<%- include('partials/head') %><section class="section"><div class="page-intro"><span class="eyebrow">ONE LAST LITTLE STEP</span><h1>Make it yours.</h1><p class="notice">DEMO PAYMENT — NO REAL MONEY WILL BE CHARGED.</p></div><form action="/checkout" method="post" class="checkout-layout"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="key" value="<%= key %>"><div><fieldset class="panel"><legend>01 · Where should it go?</legend><% if(!user.addresses.length){ %><p>Add a demo address to continue.</p><a class="button secondary" href="/account/addresses">Add address</a><% } %><% user.addresses.forEach((a,i)=>{ %><label class="address-choice"><input type="radio" name="address" value="<%= a._id %>" <%= i===0?'checked':'' %> required><span><strong><%= a.name %></strong><br><%= a.line %>, <%= a.city %>, <%= a.state %> <%= a.postal %><br><%= a.phone %></span></label><% }) %><a class="text-link" href="/account/addresses">Manage addresses ↗</a></fieldset><fieldset class="panel"><legend>02 · Choose a demo payment</legend><% [['upi','Demo UPI'],['card','Demo Card'],['cod','Demo Cash on Delivery']].forEach(([value,label],i)=>{ %><label class="address-choice"><input type="radio" name="method" value="<%= value %>" <%= i===0?'checked':'' %>><span><strong><%= label %></strong><br>No payment credentials needed.</span></label><% }) %><label>Simulated outcome<select name="outcome"><option value="success">Successful demo</option><option value="failed">Failed payment demo</option><option value="cancelled">Cancelled payment demo</option></select></label></fieldset></div><aside class="summary panel"><h2>03 · Your order</h2><% summary.items.forEach(i=>{ %><p class="summary-item"><span><%= i.name %> × <%= i.quantity %></span><strong><%= money(i.price*i.quantity) %></strong></p><% }) %><dl><div><dt>Subtotal</dt><dd><%= money(summary.subtotal) %></dd></div><div><dt>Discount</dt><dd>− <%= money(summary.discount) %></dd></div><div><dt>Demo shipping</dt><dd><%= money(summary.shipping) %></dd></div><div class="total"><dt>Total</dt><dd><%= money(summary.total) %></dd></div></dl><button class="button wide" <%= !user.addresses.length?'disabled':'' %>>Place demo order →</button><p class="small muted">No real goods or services are purchased. Prices and stock are verified again on the server.</p></aside></form></section><%- include('partials/footer') %>
