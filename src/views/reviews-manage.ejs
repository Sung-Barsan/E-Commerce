<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><h1>Reviews & returns.</h1><h2>Verified demo reviews</h2><% reviews.forEach(r=>{ %><article class="panel"><strong><%= r.product?.name||'Archived product' %> · <%= r.rating %>/5</strong><p><%= r.text %></p><form action="/admin/reviews/<%= r._id %>/hide" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small-button"><%= r.hidden?'Hidden':'Hide review' %></button></form></article><% }) %><h2>Return requests</h2><% returns.forEach(r=>{ %><article class="panel"><strong><%= r.order?.number %> · <%= r.status %></strong><p><%= r.reason %></p><% if(['requested','approved'].includes(r.status)){ %><form action="/admin/returns/<%= r._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><% if(r.status==='requested'){ %><option value="approved">Approve</option><option value="rejected">Reject</option><% }else{ %><option value="refunded">Mark simulated refund complete</option><% } %></select><button class="button secondary">Update return</button></form><% } %></article><% }) %></section></div><%- include('partials/footer') %>
