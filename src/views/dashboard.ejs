<%- include('partials/head') %><div class="dashboard-layout"><%- include('partials/dashboard-nav') %><section class="dashboard-content"><span class="eyebrow">THE BIG PICTURE</span><h1><%= title %>.</h1><p>Welcome back, <%= user.name %>. Here’s how things are looking.</p><% if(user.role==='seller'&&!user.approved){ %><p class="notice">Your seller application is awaiting administrator approval.</p><% } %><div class="metric-grid"><% [['Products',metrics.products],['Demo orders',metrics.orders],['Demo gross item value',money(metrics.revenue)],['Low-stock listings',metrics.lowStock]].forEach(([label,value])=>{ %><div class="metric"><span><%= label %></span><strong><%= value %></strong><small>From your database</small></div><% }) %></div><div class="panel chart-panel"><div class="section-heading"><h2>A week of good things.</h2><span class="badge">DEMO ORDERS</span></div><canvas id="orders-chart" data-chart="<%= JSON.stringify(chart) %>" aria-label="Demo orders over the last seven days" role="img"></canvas><p class="small muted">Chart and gross value use the latest 100 orders. Gross item value excludes cancelled items; discounts and shipping are not seller earnings.</p></div><div class="panel"><h2>Recent collection activity</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Stock</th><th>Status</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><%= p.name %></td><td><%= p.category %></td><td><%= p.stock %></td><td><span class="badge"><%= p.status %></span></td></tr><% }) %></tbody></table></div></div></section></div><%- include('partials/footer') %>
