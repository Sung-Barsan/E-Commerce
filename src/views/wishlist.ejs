<%- include('partials/head') %><section class="section"><div class="page-intro"><span class="eyebrow">A FEW THINGS YOU LOVE</span><h1>Saved for later.</h1></div><% if(!products.length){ %><div class="empty-state"><i data-lucide="heart"></i><h2>Your favorites belong here.</h2><a class="button" href="/products">Find your thing ↗</a></div><% } %><div class="product-grid"><% products.forEach(product=>{ %><div><%- include('partials/card',{product}) %><form action="/wishlist/<%= product._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="remove" value="true"><button class="text-button">Remove from saved</button></form></div><% }) %></div></section><%- include('partials/footer') %>
